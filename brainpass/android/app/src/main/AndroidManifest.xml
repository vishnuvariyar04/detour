<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================================================================
         PERMISSIONS: only what the app needs — no location, camera, mic,
         contacts, ads, or analytics. Network is used solely for parent login
         (Firebase) and subscriptions (RevenueCat/Play Billing).
         =================================================================== -->

    <!-- Parent login (Firebase Auth), profile sync (Firestore), and
         subscriptions (RevenueCat / Google Play Billing). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Nupo's audience includes CHILDREN, so the advertising ID (AAID) must
         never be transmitted (Google Play Families policy). Firebase and Play
         Billing transitively merge this permission in; strip it so no AAID can
         be accessed. Verified absent in the merged manifest. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- Lets the guard service draw the countdown chip and launch the lock
         screen over other apps from the background. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Detect which app is in the foreground (Usage access). This is a query the
         OS can't silently disable, unlike an accessibility service. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- So the parent can ask Android not to kill BrainPass in the background. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Foreground service (the always-on guard loop). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Needed to list the child's installed apps in the parent app picker. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:label="Nupo"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- ===============================================================
             The guard: a foreground service that polls UsageStats to detect
             gated apps, runs the live countdown, and shows the lock. This is
             the whole engine (no accessibility service — the OS kept disabling
             that on Xiaomi/HyperOS).
             =============================================================== -->
        <service
            android:name=".GuardService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a parental-control screen-time gate alive in the background." />
        </service>

        <!-- Restart the guard after reboot / app update. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Self-healing watchdog (fired by AlarmManager). -->
        <receiver
            android:name=".WatchdogReceiver"
            android:exported="false" />

    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Allow resolving launch intents for the app picker. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
