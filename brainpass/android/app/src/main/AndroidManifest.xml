<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================================================================
         PERMISSIONS: only what the app needs — no location, camera, mic,
         contacts, or ads. Network is used for parent login (Firebase),
         subscriptions (RevenueCat/Play Billing), and product analytics
         (Firebase Analytics, added 2026-08-31 — see the meta-data below,
         which strips every advertising signal for the child audience).
         =================================================================== -->

    <!-- Parent login (Firebase Auth), profile sync (Firestore), and
         subscriptions (RevenueCat / Google Play Billing). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Nupo's audience includes CHILDREN, so the advertising ID (AAID) must
         never be transmitted (Google Play Families policy). Firebase and Play
         Billing transitively merge this permission in; strip it so no AAID can
         be accessed. Verified absent in the merged manifest. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- Lets the guard service draw the countdown chip and launch the lock
         screen over other apps from the background. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Detect which app is in the foreground (Usage access). This is a query the
         OS can't silently disable, unlike an accessibility service. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- So the parent can ask Android not to kill BrainPass in the background. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Foreground service (the always-on guard loop). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Needed to list the child's installed apps in the parent app picker. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:label="Nupo"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- ===============================================================
             ANALYTICS, CONFIGURED FOR A CHILD-DIRECTED APP.

             Firebase Analytics was added on 2026-08-31 to measure the
             onboarding funnel and retention (see lib/analytics.dart and
             Analytics.kt). Google Play Families forbids advertising
             identifiers and ad personalisation for a child audience, so all
             three ad-related signals are turned OFF here — the AD_ID
             permission is separately stripped above, and SSAID collection is
             disabled so no device-scoped identifier is sent either.

             These flags are what make the SDK compliant for this audience.
             Do not remove them. legal/DATA_SAFETY.md declares what is left.
             =============================================================== -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_user_data"
            android:value="false" />
        <meta-data
            android:name="google_analytics_ssaid_collection_enabled"
            android:value="false" />

        <!-- PostHog, alongside Firebase, on PostHog Cloud EU
             (eu.i.posthog.com). The project token comes from
             android/posthog.properties at build time; empty means PostHog
             stays off.

             The plugin's own AUTO_INIT is off: PostHogInit (a ContentProvider,
             the same trick Firebase uses) starts the SDK once per process with
             the child-safe settings in Analytics.kt, before any Activity or the
             guard runs. A guard started at boot has no Flutter engine, so the
             plugin could not be the one to start it. -->
        <!-- Meta (Facebook/Instagram ads) app events, for measuring which ads
             bring parents who set up and subscribe. The ADVERTISING ID stays
             off (AD_ID is removed above): Meta matches Play installs to ad
             taps through the install referrer. Purchases reach Meta from
             RevenueCat's servers, not from here, so they are not double
             counted. With no app id in android/meta.properties the SDK is
             never started (AutoInitEnabled false). -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />
        <meta-data
            android:name="com.facebook.sdk.AutoInitEnabled"
            android:value="${metaAutoInit}" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="${metaAutoInit}" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="false" />

        <meta-data
            android:name="com.posthog.posthog.AUTO_INIT"
            android:value="false" />
        <meta-data
            android:name="app.nupo.posthog.HOST"
            android:value="${posthogHost}" />
        <meta-data
            android:name="app.nupo.posthog.TOKEN"
            android:value="${posthogToken}" />
        <!-- Trial reminder (lib/trial_reminder.dart): flutter_local_notifications
             fires the "your free trial ends tomorrow" notification the paywall
             promises, and re-arms it after a reboot or an app update. -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <provider
            android:name=".PostHogInit"
            android:authorities="${applicationId}.posthoginit"
            android:exported="false"
            android:initOrder="90" />

        <!-- ===============================================================
             The guard: a foreground service that polls UsageStats to detect
             gated apps, runs the live countdown, and shows the lock. This is
             the whole engine (no accessibility service — the OS kept disabling
             that on Xiaomi/HyperOS).
             =============================================================== -->
        <!-- Debug-only gallery of the Number Sense drawings; see
             NumberPreviewActivity. Exported so adb can launch it. -->
        <activity
            android:name=".NumberPreviewActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Light.NoTitleBar" />

        <!-- The same, for the two skills that are authored but not yet served.
             Exported so adb can launch it; it finishes at once unless the build
             is debuggable. -->
        <activity
            android:name=".PuzzlePreviewActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Light.NoTitleBar" />

        <service
            android:name=".GuardService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a parental-control screen-time gate alive in the background." />
        </service>

        <!-- Restart the guard after reboot / app update. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Self-healing watchdog (fired by AlarmManager). -->
        <receiver
            android:name=".WatchdogReceiver"
            android:exported="false" />

    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Allow resolving launch intents for the app picker. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
