lete","prompt":"One step is missing. Tap the one that goes in the gap.","hint":"What must Nupo be holding when he gets to the door?","visual":{"w":5,"h":5,"start":[0,0],"key":[2,0],"door":[3,0],"program":["right","right","?","right","open"]},"optionsText":["PICK UP","UP","LEFT"],"answer":{"type":"option","value":0},"id":"1.1.3#5"},{"shape":"debug","prompt":"Tap the first step Nupo cannot do.","hint":"He walks straight past something he needs.","visual":{"w":5,"h":5,"start":[0,0],"key":[1,0],"door":[3,0],"program":["right","right","right","open","pick"]},"answer":{"type":"block","value":3},"id":"1.1.3#6"},{"shape":"choose","prompt":"Tap the one that gets both stars and then the flag.","hint":"Nupo must walk over both stars, not just reach the flag.","visual":{"w":5,"h":5,"start":[0,0],"goal":[3,2],"stars":[[1,0],[3,1]]},"options":[["right","right","right","up","up"],["up","up","right","right","right"],["right","up","up","right","right"]],"answer":{"type":"option","value":0},"id":"1.1.4#0"},{"shape":"fix","prompt":"Put the steps in order to get the star, then the flag.","hint":"Pick up the star on the way past.","visual":{"w":5,"h":5,"start":[0,0],"goal":[2,2],"stars":[[1,1]]},"blocks":["up","right","up","right"],"slots":4,"answer":{"type":"order","value":["right","up","right","up"]},"id":"1.1.4#1"},{"shape":"debug","prompt":"Tap the first step that goes wrong.","hint":"Look for the step that bumps into the wall.","visual":{"w":5,"h":5,"start":[0,0],"goal":[3,1],"walls":[[2,0]],"program":["right","right","right","up"]},"answer":{"type":"block","value":1},"id":"1.1.4#2"},{"shape":"predict","prompt":"Nupo takes four steps right. Tap the square he ends on.","hint":"Do every step, even the ones after he passes the flag.","visual":{"w":5,"h":5,"start":[0,0],"goal":[2,0],"program":["right","right","right","right"]},"answer":{"type":"cell","value":[4,0]},"id":"1.1.4#3"},{"shape":"count","prompt":"What is the smallest number of steps that reaches the flag? Tap the number.","h