function planeInBox(pt,nm,lo,hi){
  const E=[], corners=[];
  for(let i=0;i<8;i++) corners.push([i&1?hi[0]:lo[0], i&2?hi[1]:lo[1], i&4?hi[2]:lo[2]]);
  for(let i=0;i<8;i++) for(let j=i+1;j<8;j++){ const d=i^j; if(d===1||d===2||d===4) E.push([corners[i],corners[j]]); }
  const pts=[], dotp=function(a){return (a[0]-pt[0])*nm[0]+(a[1]-pt[1])*nm[1]+(a[2]-pt[2])*nm[2];};
  E.forEach(function(e){ const da=dotp(e[0]), db=dotp(e[1]);
    if(da*db<0){ const t=da/(da-db); pts.push([0,1,2].map(function(k){return e[0][k]+t*(e[1][k]-e[0][k]);})); } });
  const cxp=[0,1,2].map(function(k){return pts.reduce(function(s,q){return s+q[k];},0)/pts.length;});
  const ln=Math.hypot(nm[0],nm[1],nm[2]), N=nm.map(function(v){return v/ln;});
  const hlp=Math.abs(N[0])<0.9?[1,0,0]:[0,1,0];
  const U=[hlp[1]*N[2]-hlp[2]*N[1], hlp[2]*N[0]-hlp[0]*N[2], hlp[0]*N[1]-hlp[1]*N[0]];
  const V=[N[1]*U[2]-N[2]*U[1], N[2]*U[0]-N[0]*U[2], N[0]*U[1]-N[1]*U[0]];
  pts.sort(function(m,n){
    const dm=[m[0]-cxp[0],m[1]-cxp[1],m[2]-cxp[2]], dn=[n[0]-cxp[0],n[1]-cxp[1],n[2]-cxp[2]];
    return Math.atan2(dm[0]*V[0]+dm[1]*V[1]+dm[2]*V[2], dm[0]*U[0]+dm[1]*U[1]+dm[2]*U[2])
         - Math.atan2(dn[0]*V[0]+dn[1]*V[1]+dn[2]*V[2], dn[0]*U[0]+dn[1]*U[1]+dn[2]*U[2]); });
  return pts;
}
