/* ------------------------------------------------------------- options */
/* A labelled box with a number in it.

   Code.org teaches this unplugged as an ENVELOPE: a label on the outside, a
   card inside that can be swapped. The drawing follows that — the name is the
   label, the number is the card — so the picture agrees with the lesson
   instead of being an empty grid the child has to ignore. */
function drawBoxes(c,boxes,x,y,w){
  const h=84, gap=12, bw=(w-gap*(boxes.length-1))/boxes.length;
  boxes.forEach(([name,value],i)=>{
    const bx=x+i*(bw+gap);
    rrect(c,bx,y,bw,h,18,K.surface,K.primary,2.5);
    text(c,name,bx+bw/2,y+24,12,K.muted,900,"center");
    text(c,String(value),bx+bw/2,y+h-18,30,K.primary,900,"center");
  });
  return h+4;
}

/* The step-by-step table. One row per step, the box's value beside it, and
   one row left blank for the child to work out. This is the representation
   the UK computing curriculum calls a trace table, given as a worked example
   with values missing — which is the form the research says works. */
function drawTrace(c,steps,values,gapRow,boxName,x,y,w){
  const rowH=40, headH=34, split=x+w*0.62;
  const h=headH+steps.length*rowH;
  rrect(c,x,y,w,h,14,K.surface,K.line,2);
  text(c,"STEP",x+14,y+headH*0.66,11.5,K.muted,900);
  text(c,boxName||"COINS",split+(x+w-split)/2,y+headH*0.66,11.5,K.muted,900,"center");
  steps.forEach((label,i)=>{
    const top=y+headH+i*rowH;
    if(i>0){ c.fillStyle=K.line; c.fillRect(x+10,top,w-20,1); }
    text(c,label,x+14,top+rowH/2,13,K.text,600);
    if(i===gapRow){
      rrect(c,split+18,top+7,w-(split-x)-36,rowH-14,9,"#F3EFFF",K.primary,2);
      text(c,"?",split+(x+w-split)/2,top+rowH/2,17,K.primary,900,"center");
    } else {
      text(c,String(values[i]),split+(x+w-split)/2,top+rowH/2,16,K.text,800,"center");
    }
  });
  return h+4;
}

/* The two lists a compare question is ABOUT. Without these the child is shown
   a bare board and asked whether "these two" end in the same place, with no
   two of anything on the screen. */
function compareCards(c,options,x,y,w){
  const rowH=58, gap=8;
  options.forEach((prog,i)=>{
    const ry=y+i*(rowH+gap);
    rrect(c,x,ry,w,rowH,16,K.surface,K.line,1.5);
    text(c,String.fromCharCode(65+i),x+22,ry+rowH/2,14,K.muted,900,"center");
    text(c,"RUN",x+w-16,ry+rowH/2,12,K.primary,900,"right");
    // chips, sized to their own words so nothing runs together
    const avail=w-44-46, chipGap=6;
    let size=9.5, widths;
    for(;;){
      c.font=`800 ${size}px Nunito,system-ui,sans-serif`;
      widths=prog.map(t=>Math.max(14,c.measureText(shortWord(t)).width));
      const tot=widths.reduce((a,b)=>a+b,0)+chipGap*(prog.length-1);
      if(tot<=avail||size<=6.5) break;
      size-=0.5;
    }
    let cx=x+44;
    prog.forEach((t,k)=>{
      const cw=widths[k], scaf=isScaffold(t);
      rrect(c,cx,ry+15,cw+10,rowH-30,8,scaf?"#F3EFFF":K.bg,scaf?"#E4DBFF":K.line,1.2);
      text(c,shortWord(t),cx+(cw+10)/2,ry+rowH/2,size,scaf?K.primary:K.text,800,"center");
      cx+=cw+10+chipGap;
    });
  });
  return options.length*(rowH+gap);
}

/* The drag tray: empty boxes to fill, and the steps to fill them with.

   BlockBankView draws a row of slots above a row of chips. Without this the
   review page showed a board and a listing for every fix/inverse/constrain
   question and no way to answer it — twenty-two screens that looked broken
   because the control was missing, not because the question was. */
function drawBank(c,blocks,slots,x,y,w,reusable){
  const h=58, gap=6;
  const sw=(w-gap*(slots-1))/slots;
  for(let i=0;i<slots;i++){
    const bx=x+i*(sw+gap);
    // a ghost box: dashed, empty, waiting
    c.save(); c.setLineDash([5,5]);
    rrect(c,bx,y,sw,h,16,K.bg,K.line,2);
    c.restore();
  }
  const ty=y+h+14;
  const tw=(w-gap*(blocks.length-1))/blocks.length;
  blocks.forEach((t,i)=>{
    const bx=x+i*(tw+gap);
    rrect(c,bx,ty,tw,h,16,K.surface,K.line,1.5);
    const label=word(t);
    if(ARROWS[t]){
      arrow(c,bx+tw/2,ty+h/2-7,8,t,K.text);
      text(c,label,bx+tw/2,ty+h/2+13,10.5,K.text,800,"center");
    } else {
      text(c,label,bx+tw/2,ty+h/2,label.length>7?10.5:12.5,K.text,800,"center");
    }
  });
  return h*2+14;
}

