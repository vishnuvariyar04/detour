function shortWord(t){
  if(t==="pick")return "PICK"; if(t==="end")return "END"; if(t==="else")return "ELSE";
  if(t.startsWith("repeat:"))return "x"+t.split(":")[1];
  if(t.startsWith("if:"))return "IF";
  if(t.startsWith("set:")||t.startsWith("add:")){
    const q=t.split(":"); const n=parseInt(q[2],10);
    return q[0]==="set"?"="+q[2]:(n<0?String(n):"+"+n);
  }
  return word(t);
}

/* ------------------------------------------------------------- a screen */
function render(cv,q){
