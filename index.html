<title>Nupo Question Wall</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap">
<style>
:root{
  --ground:#EEEFF4; --panel:#FFFFFF; --panel-2:#F7F8FC;
  --ink:#20222C; --ink-2:#5B5F72; --muted:#8B8FA3;
  --edge:#DBDDE8; --edge-2:#C7CAD9;
  --tool:#E1502A; --tool-soft:#FDEAE4;
  --flag:#B26A00; --flag-soft:#FFF3DC;
  --ok:#12784A;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --ground:#131521; --panel:#1B1E2B; --panel-2:#232735;
    --ink:#E8E9F1; --ink-2:#AFB3C6; --muted:#7E8398;
    --edge:#2C3143; --edge-2:#3A4056;
    --tool:#FF7A59; --tool-soft:#3A2018;
    --flag:#FFB020; --flag-soft:#382A12;
    --ok:#4ADE9B;
  }
}
:root[data-theme="dark"]{
  --ground:#131521; --panel:#1B1E2B; --panel-2:#232735;
  --ink:#E8E9F1; --ink-2:#AFB3C6; --muted:#7E8398;
  --edge:#2C3143; --edge-2:#3A4056;
  --tool:#FF7A59; --tool-soft:#3A2018;
  --flag:#FFB020; --flag-soft:#382A12;
  --ok:#4ADE9B;
}
*{box-sizing:border-box}
body{
  margin:0; background:var(--ground); color:var(--ink);
  font-family:"IBM Plex Sans",system-ui,-apple-system,Segoe UI,sans-serif;
  font-size:14px; line-height:1.5;
}
code,.mono{font-family:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace}

/* ---------------------------------------------------------------- chrome */
header{
  position:sticky; top:0; z-index:20; background:var(--panel);
  border-bottom:1px solid var(--edge);
  padding:14px 20px 12px; display:flex; flex-wrap:wrap; gap:14px; align-items:center;
}
h1{
  font-size:16px; font-weight:700; margin:0; letter-spacing:-.01em;
  display:flex; align-items:baseline; gap:9px;
}
h1 .sub{font-size:12px; font-weight:500; color:var(--muted); letter-spacing:.02em}
.tallies{display:flex; gap:16px; margin-left:auto; align-items:center; flex-wrap:wrap}
.tally{display:flex; flex-direction:column; line-height:1.15}
.tally b{font-family:"IBM Plex Mono",monospace; font-size:16px; font-weight:600;
  font-variant-numeric:tabular-nums}
.tally span{font-size:10.5px; color:var(--muted); text-transform:uppercase; letter-spacing:.07em}
.controls{display:flex; gap:8px; flex-wrap:wrap; align-items:center; width:100%}
select,input[type=search],button{
  font:inherit; color:var(--ink); background:var(--panel-2);
  border:1px solid var(--edge); border-radius:8px; padding:6px 10px;
}
input[type=search]{min-width:200px}
button{cursor:pointer}
button:hover{border-color:var(--edge-2)}
button.primary{background:var(--tool); border-color:var(--tool); color:#fff; font-weight:600}
button.primary:hover{filter:brightness(1.06)}
:focus-visible{outline:2px solid var(--tool); outline-offset:2px}
.chk{display:flex; align-items:center; gap:6px; font-size:13px; color:var(--ink-2)}

/* ---------------------------------------------------------------- wall */
main{padding:20px 20px 150px}
.unit{margin:0 0 30px}
.unit-head{
  display:flex; align-items:baseline; gap:10px; margin:0 0 12px;
  padding-bottom:7px; border-bottom:1px solid var(--edge);
}
.unit-head h2{margin:0; font-size:14.5px; font-weight:600; letter-spacing:-.01em}
.unit-head .id{font-family:"IBM Plex Mono",monospace; font-size:12px; color:var(--tool)}
.unit-head .note{font-size:12px; color:var(--muted); margin-left:auto}
.grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(212px,1fr)); gap:16px}
figure{margin:0; display:flex; flex-direction:column; gap:7px}
.frame{
  position:relative; border-radius:14px; overflow:hidden; cursor:pointer;
  border:1px solid var(--edge); background:#F6F7FB;
  aspect-ratio:1080/2392; transition:border-color .12s, box-shadow .12s;
}
.frame canvas{width:100%; height:100%; display:block}
.frame:hover{border-color:var(--edge-2)}
figure.sel .frame{border-color:var(--tool); box-shadow:0 0 0 3px var(--tool-soft)}
.cap{display:flex; align-items:center; gap:6px; flex-wrap:wrap; font-size:11.5px}
.cap .qid{font-family:"IBM Plex Mono",monospace; color:var(--ink-2); font-weight:500}
.tag{
  font-size:10px; letter-spacing:.04em; text-transform:uppercase; font-weight:600;
  padding:2px 6px; border-radius:5px; background:var(--panel-2);
  color:var(--muted); border:1px solid var(--edge);
}
.tag.dup{background:var(--flag-soft); color:var(--flag); border-color:transparent}
.facts{
  width:100%; margin-top:2px; font-size:11px; line-height:1.45; color:var(--muted);
}
.facts b{color:var(--ink-2); font-weight:600}
.facts .ans{color:var(--tool); font-weight:600}
.badge{
  position:absolute; top:8px; left:8px; z-index:2;
  font-size:9.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase;
  padding:3px 7px; border-radius:999px; background:var(--flag); color:#231600;
}
figure.sel .frame::after{
  content:"✓"; position:absolute; top:7px; right:7px; z-index:2;
  width:20px; height:20px; border-radius:50%; background:var(--tool); color:#fff;
  font-size:12px; font-weight:700; display:grid; place-items:center;
}

/* ---------------------------------------------------------------- basket */
.basket{
  position:fixed; left:0; right:0; bottom:0; z-index:30; background:var(--panel);
  border-top:1px solid var(--edge); max-height:56vh; display:flex; flex-direction:column;
  transform:translateY(calc(100% - 46px)); transition:transform .18s ease;
}
.basket.open{transform:translateY(0)}
.basket-bar{
  display:flex; align-items:center; gap:12px; padding:0 20px; height:46px;
  cursor:pointer; user-select:none; flex:0 0 auto;
}
.basket-bar b{font-family:"IBM Plex Mono",monospace; font-size:14px}
.basket-bar .spacer{margin-left:auto}
.basket-body{overflow:auto; padding:4px 20px 18px; display:grid; gap:9px}
.row{
  display:grid; grid-template-columns:118px 1fr auto; gap:10px; align-items:center;
  padding:8px 10px; background:var(--panel-2); border:1px solid var(--edge); border-radius:9px;
}
.row .qid{font-family:"IBM Plex Mono",monospace; font-size:12px; color:var(--tool)}
.row input{
  font:inherit; font-size:13px; width:100%; padding:5px 8px; color:var(--ink);
  background:var(--panel); border:1px solid var(--edge); border-radius:7px;
}
.row button{padding:4px 8px; font-size:12px}
.empty{color:var(--muted); font-size:13px; padding:10px 0}
@media (max-width:560px){
  .row{grid-template-columns:1fr; }
  .tallies{width:100%; margin-left:0}
}
</style>

<header>
  <h1>Question Wall <span class="sub">every screen a child will see</span></h1>
  <div class="tallies">
    <div class="tally"><b id="t-shown">0</b><span>shown</span></div>
    <div class="tally"><b id="t-total">0</b><span>total</span></div>
    <div class="tally"><b id="t-dup" style="color:var(--flag)">0</b><span>same screen</span></div>
    <div class="tally"><b id="t-echo">0</b><span>same words</span></div>
    <div class="tally"><b id="t-sel" style="color:var(--tool)">0</b><span>picked</span></div>
  </div>
  <div class="controls">
    <select id="f-skill"></select>
    <select id="f-shape"></select>
    <input type="search" id="f-text" placeholder="Search the prompt…">
    <label class="chk"><input type="checkbox" id="f-dup"> Repeats only</label>
    <label class="chk"><input type="checkbox" id="f-echo"> Same words only</label>
    <label class="chk"><input type="checkbox" id="f-sel"> Picked only</label>
    <button id="clear">Clear filters</button>
  </div>
</header>

<main id="wall"></main>

<section class="basket" id="basket">
  <div class="basket-bar" id="basket-bar">
    <b id="b-count">0</b> picked
    <span class="spacer"></span>
    <button id="copy" class="primary">Copy notes for Claude</button>
    <button id="wipe">Clear</button>
  </div>
  <div class="basket-body" id="basket-body"></div>
</section>

