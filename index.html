  const h=Math.min(w,260), s=Math.min(w,h)*0.86;
  const ox=x+(w-s)/2, oy=y+(h-s)/2;
  for(const part of (pic.parts||[])){
    c.beginPath();
    part.pts.forEach((pt,i)=>{const px=ox+pt[0]*s, py=oy+pt[1]*s;
      i?c.lineTo(px,py):c.moveTo(px,py);});
    c.closePath();
    c.fillStyle="#F3F1FB"; c.fill();
    c.lineJoin="round"; c.lineCap="round"; c.lineWidth=3.5;
