    // A board with no flag, star, wall, key or door is scenery. For a box
    // question the box is the subject, so the grid is left out entirely.
    const hasWorld=!!(vis.goal||(vis.stars||[]).length||(vis.walls||[]).length
                      ||vis.key||vis.door);
    if(vars) y+=drawBoxes(c,vars,M,y,CW)+14;
    const wide=(vis.w||5)>=6||(vis.h||5)>=6;
    const prog=vis.program||[];
    const showGrid=!vars||hasWorld;
    if(!showGrid){
      if(prog.length) y+=drawListing(c,prog,M,y,CW,true)+10;
    } else if(prog.length&&!wide){
      const bw=CW*0.55;
      drawBoard(c,vis,M,y,bw,190);
      drawListing(c,prog,M+bw+10,y,CW-bw-10,true);
      y+=Math.max(190,prog.length*40)+16;
    } else {
      y+=drawBoard(c,vis,M,y,CW,wide?260:210)*0+ (wide?260:210) +12;
      if(prog.length) y+=drawListing(c,prog,M,y,CW,true)+10;
    }
    // The two lists a compare question is asking about.
    if(sh==="compare"&&q.options&&q.options.length)
      y+=compareCards(c,q.options,M,y,CW)+12;
  }

  // the answer control
  if(q.blocks&&q.blocks.length&&q.slots){
    y+=drawBank(c,q.blocks,q.slots,M,y,CW,q.reusable)+8;
    if(!q.caption) q=Object.assign({},q,{caption: q.reusable
      ? "Fill every box, then run it. Steps can be used again."
      : "Tap the steps to fill the boxes, then run it."});
  }
  else if(q.optionCubes&&q.optionCubes.length) y+=cubeOptions(c,q.optionCubes,M,y,CW)+8;
  else if(q.optionSections&&q.optionSections.length) y+=sectionOptions(c,q.optionSections,M,y,CW)+8;
  else if(q.optionShapes&&q.optionShapes.length) y+=shapeOptions(c,q.optionShapes,M,y,CW)+8;
  else if(q.optionBits&&q.optionBits.length) y+=bitOptions(c,q.optionBits,pic&&pic.values,M,y,CW)+8;
  else if(q.optionNets&&q.optionNets.length) y+=netOptions(c,q.optionNets,M,y,CW)+8;
  else if(q.optionViews&&q.optionViews.length) y+=viewOptions(c,q.optionViews,M,y,CW)+8;
  else if(q.choices&&q.choices.length) y+=numberKeys(c,q.choices,M,y,CW)+8;
  else if(q.optionCells&&q.optionCells.length) y+=cellOptions(c,q.optionCells,M,y,CW)+8;
  else if(sh==="balance") y+=textOptions(c,["Left","Right","Same"],M,y,CW)+8;
  else if(sh==="fraction") y+=textOptions(c,["Left","Right"],M,y,CW)+8;
  else if(sh==="yesno") y+=textOptions(c,["Yes","No"],M,y,CW)+8;
  else if(sh==="compare") y+=textOptions(c,["The same square","Different squares"],M,y,CW)+8;
  else if(q.optionsText&&q.optionsText.length) y+=textOptions(c,q.optionsText,M,y,CW)+8;
  else if(q.options&&q.options.length) y+=programOptions(c,q.options,M,y,CW)+8;

  if(q.caption) text(c,q.caption,W/2,y+6,13.5,K.muted,600,"center");

  // action bar
  const by=H-70;
  rrect(c,M,by+5,96,54,18,K.ledge); rrect(c,M,by,96,54,18,K.surface,K.line,1.5);
  text(c,"Hint",M+48,by+27,15,K.ink||K.text,700,"center");
  rrect(c,M+108,by+5,CW-108,54,18,"#B9A0F5");
  rrect(c,M+108,by,CW-108,54,18,"#C4AEF7");
  text(c,(q.blocks&&q.blocks.length&&q.slots)?"Run it":"Check",
       M+108+(CW-108)/2,by+27,17,"#FFFFFF",800,"center");
}

/* The answer in the words a reviewer needs, not the shape the app grades.
   Checking 648 pictures for beauty is half a review; the other half is
   checking that the answer under each one is the true one. */
function answerWords(q){
  const a=q.answer; if(!a) return "";
  const v=a.value;
  switch(a.type){
    case "cell":   return `the square ${v[0]} across, ${v[1]} up`;
    case "number": return String(v);
    case "bool":
      return q.shape==="yesno" ? (v?"Yes":"No")
           : q.shape==="compare" ? (v?"the same square":"different squares")
           : (v?"yes":"no");
    case "block":  return `step ${v+1}${q.visual&&q.visual.program?
                     ' (“'+word(q.visual.program[v])+'”)':""}`;
    case "option": {
      const t=q.optionsText&&q.optionsText[v];
      if(t) return `“${t}”`;
      const o=q.options&&q.options[v];
      if(o) return `option ${v+1}: ${o.map(word).join(" · ")}`;
      if(q.optionBits) return `bulbs ${q.optionBits[v].map(b=>b?"●":"○").join(" ")}`;
      if(q.optionNets) return `net ${v+1}`;
      if(q.optionCubes) return `picture ${v+1}`;
      if(q.optionShapes) return `the ${q.optionShapes[v]}`;
      if(q.optionSections) return `cut ${v+1}`;
      if(q.optionViews) return `view ${v+1} (heights ${q.optionViews[v].join(", ")})`;
      if(q.optionCells) return `the ${q.optionCells[v].kind}`;
      return `option ${v+1}`;
    }
    case "order":  return Array.isArray(v)?v.map(word).join(" · "):String(v);
    default:       return JSON.stringify(v);
  }
}

/* ------------------------------------------------------------- the wall */
const $=s=>document.querySelector(s);
const esc=t=>String(t==null?"":t).replace(/[&<>"]/g,
  ch=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;"}[ch]));
const state={sel:new Map()};
let items=[];
DATA.skills.forEach(sk=>sk.units.forEach(u=>u.qs.forEach(q=>{
  q._skill=sk.name; q._skillId=sk.id; q._unit=u.name; q._unitId=u.id; items.push(q);
})));
$("#t-total").textContent=items.length;
$("#t-dup").textContent=items.filter(q=>q.dup).length;
$("#t-echo").textContent=items.filter(q=>q.echo).length;

const fSkill=$("#f-skill"), fShape=$("#f-shape");
fSkill.innerHTML='<option value="">Both skills</option>'+
  DATA.skills.map(s=>`<option value="${s.id}">${s.name}</option>`).join("");
fShape.innerHTML='<option value="">Every kind</option>'+
  [...new Set(items.map(q=>q.shape))].sort()
  .map(s=>`<option value="${s}">${s}</option>`).join("");

const io=new IntersectionObserver(es=>{
  for(const e of es){
    if(!e.isIntersecting) continue;
    const cv=e.target.querySelector("canvas");
    if(cv&&!cv.dataset.done){ cv.dataset.done="1"; render(cv,JSON.parse(cv.dataset.q)); }
    io.unobserve(e.target);
  }
},{rootMargin:"600px 0px"});

function build(){
  const sk=fSkill.value, shp=fShape.value, txt=$("#f-text").value.trim().toLowerCase();
  const dupOnly=$("#f-dup").checked, echoOnly=$("#f-echo").checked,
        selOnly=$("#f-sel").checked;
  const keep=q=>(!sk||q._skillId===sk)&&(!shp||q.shape===shp)
    &&(!txt||(q.prompt||"").toLowerCase().includes(txt))
    &&(!dupOnly||q.dup)&&(!echoOnly||q.echo)&&(!selOnly||state.sel.has(q.id));
  const wall=$("#wall"); wall.innerHTML="";
  let shown=0, lastUnit=null, grid=null;
  for(const q of items){
    if(!keep(q)) continue;
    if(q._unitId!==lastUnit){
      lastUnit=q._unitId;
      const sec=document.createElement("section"); sec.className="unit";
      sec.innerHTML=`<div class="unit-head"><span class="id">${q._unitId}</span>`+
        `<h2>${q._unit}</h2><span class="note">${q._skill}</span></div>`;
      grid=document.createElement("div"); grid.className="grid";
      sec.appendChild(grid); wall.appendChild(sec);
    }
    const fig=document.createElement("figure");
    if(state.sel.has(q.id)) fig.classList.add("sel");
    fig.innerHTML=
      `<div class="frame">${q.dup?'<span class="badge">repeat</span>':""}`+
      `<canvas data-q='${JSON.stringify(q).replace(/'/g,"&#39;")}'></canvas></div>`+
      `<figcaption class="cap"><span class="qid">${q.id}</span>`+
      `<span class="tag">${q.shape}</span>`+
      `${q.dup?'<span class="tag dup">×'+q.dup+"</span>":""}`+
      `${q.echo&&!q.dup?'<span class="tag">same words ×'+q.echo+"</span>":""}`+
      `<div class="facts"><span class="ans">answer: ${esc(answerWords(q))}</span>`+
      `${q.hint?"<br><b>hint:</b> "+esc(q.hint):""}</div>`+
      `</figcaption>`;
    fig.querySelector(".frame").addEventListener("click",()=>toggle(q,fig));
    grid.appendChild(fig); io.observe(fig); shown++;
  }
  $("#t-shown").textContent=shown;
  if(!shown) wall.innerHTML='<p class="empty">Nothing matches those filters.</p>';
}
function toggle(q,fig){
  if(state.sel.has(q.id)) state.sel.delete(q.id);
  else state.sel.set(q.id,{q,note:""});
  fig.classList.toggle("sel");
  paintBasket();
}
function paintBasket(){
  const n=state.sel.size;
  $("#t-sel").textContent=n; $("#b-count").textContent=n;
  const body=$("#basket-body");
  if(!n){ body.innerHTML='<p class="empty">Tap any screen to pick it, then say what to change.</p>'; return; }
  body.innerHTML="";
  for(const [id,v] of state.sel){
    const row=document.createElement("div"); row.className="row";
    row.innerHTML=`<span class="qid">${id} · ${v.q.shape}</span>`+
      `<input id="note-${id.replace(/[^\w]/g,'_')}" value="${(v.note||"").replace(/"/g,"&quot;")}" placeholder="What should change here?">`+
      `<button>Remove</button>`;
    row.querySelector("input").addEventListener("input",e=>v.note=e.target.value);
    row.querySelector("button").addEventListener("click",()=>{
      state.sel.delete(id); build(); paintBasket();
    });
    body.appendChild(row);
  }
}
$("#copy").addEventListener("click",async()=>{
  const lines=[...state.sel].map(([id,v])=>
    `${id} (${v.q.shape}, ${v.q._skillId}) — ${v.q.prompt}\n    change: ${v.note||"(not said)"}`);
  const out=lines.length?"Questions to change:\n\n"+lines.join("\n\n"):"Nothing picked.";
  try{ await navigator.clipboard.writeText(out); $("#copy").textContent="Copied"; }
  catch{ $("#copy").textContent="Press Ctrl+C"; console.log(out); }
  setTimeout(()=>$("#copy").textContent="Copy notes for Claude",1400);
});
$("#wipe").addEventListener("click",()=>{state.sel.clear();build();paintBasket();});
$("#basket-bar").addEventListener("click",e=>{
  if(e.target.tagName==="BUTTON")return;
  $("#basket").classList.toggle("open");
});
["#f-skill","#f-shape","#f-dup","#f-echo","#f-sel"].forEach(s=>$(s).addEventListener("change",build));
$("#f-text").addEventListener("input",build);
$("#clear").addEventListener("click",()=>{
  fSkill.value="";fShape.value="";$("#f-text").value="";
  $("#f-dup").checked=false;$("#f-echo").checked=false;
  $("#f-sel").checked=false;build();
});
nupo.onload=()=>document.querySelectorAll("canvas[data-done]").forEach(cv=>{
  render(cv,JSON.parse(cv.dataset.q));
});
build(); paintBasket();
</script>
