/* ------------------------------------------------------------- glyphs */
function poly(c,cx,cy,r,n,start){
  c.beginPath();
  for(let i=0;i<n;i++){
    const a=(start+i*360/n)*Math.PI/180;
    const x=cx+r*Math.cos(a), y=cy+r*Math.sin(a);
    i?c.lineTo(x,y):c.moveTo(x,y);
  }
  c.closePath();
}
function starPath(c,cx,cy,r){
  c.beginPath();
  for(let i=0;i<10;i++){
    const rad=i%2?r*0.46:r, a=(-90+i*36)*Math.PI/180;
    const x=cx+rad*Math.cos(a), y=cy+rad*Math.sin(a);
    i?c.lineTo(x,y):c.moveTo(x,y);
  }
  c.closePath();
}
function heartPath(c,cx,cy,r){
  const top=cy-r*0.42;
  c.beginPath(); c.moveTo(cx,cy+r*0.78);
  c.bezierCurveTo(cx-r*1.35,cy-r*0.15,cx-r*0.62,top-r*0.62,cx,top);
  c.bezierCurveTo(cx+r*0.62,top-r*0.62,cx+r*1.35,cy-r*0.15,cx,cy+r*0.78);
  c.closePath();
}
function shape(c,kind,cx,cy,r,rot){
  if(rot){c.save();c.translate(cx,cy);c.rotate(rot*Math.PI/180);c.translate(-cx,-cy);}
  switch(kind){
    case "square":{const q=r*0.9,rr=r*0.26;
      c.beginPath();c.roundRect(cx-q,cy-q,q*2,q*2,rr);c.fill();break;}
    case "triangle": poly(c,cx,cy,r,3,-90); c.fill(); break;
    case "diamond":  poly(c,cx,cy,r,4,-90); c.fill(); break;
    case "hexagon":  poly(c,cx,cy,r,6,-90); c.fill(); break;
    case "star":     starPath(c,cx,cy,r); c.fill(); break;
    case "heart":    heartPath(c,cx,cy,r); c.fill(); break;
    case "flower":
      for(let i=0;i<6;i++){const a=i*60*Math.PI/180;
        c.beginPath();c.arc(cx+r*0.55*Math.cos(a),cy+r*0.55*Math.sin(a),r*0.45,0,7);c.fill();}
      c.beginPath();c.arc(cx,cy,r*0.42,0,7);c.fill();break;
    default: c.beginPath();c.arc(cx,cy,r,0,7);c.fill();
  }
  if(rot)c.restore();
}
function glyph(c,kind,cx,cy,r,face,ledge,rot){
  if(ledge){c.fillStyle=ledge; shape(c,kind,cx,cy+r*0.13,r,rot);}
  c.fillStyle=face; shape(c,kind,cx,cy,r,rot);
}
const COLOR = k => k==="accent"?K.accent:k==="good"?K.good:K.primary;
const LEDGE = k => k==="accent"?K.accentLedge:k==="good"?K.good:K.primaryLedge;

/* ------------------------------------------------------------- helpers */
function rrect(c,x,y,w,h,r,fill,stroke,sw){
  c.beginPath(); c.roundRect(x,y,w,h,r);
  if(fill){c.fillStyle=fill;c.fill();}
  if(stroke){c.lineWidth=sw||1.5;c.strokeStyle=stroke;c.stroke();}
}
function text(c,s,x,y,size,color,weight,align){
  c.fillStyle=color; c.textAlign=align||"left"; c.textBaseline="middle";
  c.font=`${weight||700} ${size}px Nunito, sans-serif`;
  c.fillText(s,x,y);
}
function wrap(c,s,x,y,maxW,size,color,weight,lh){
  c.font=`${weight||900} ${size}px Nunito, sans-serif`;
  const words=String(s||"").split(" "); let line="", yy=y;
  for(const w of words){
    const t=line?line+" "+w:w;
    if(c.measureText(t).width>maxW && line){
      text(c,line,x,yy,size,color,weight); yy+=lh||size*1.35; line=w;
    } else line=t;
  }
  if(line) text(c,line,x,yy,size,color,weight);
  return yy+(lh||size*1.35);
}
function arrow(c,cx,cy,size,dir,color){
  c.save(); c.translate(cx,cy);
  c.rotate({right:0,down:90,left:180,up:270}[dir]*Math.PI/180);
  c.fillStyle=color; c.strokeStyle=color; c.lineWidth=size*0.42; c.lineCap="round";
  c.beginPath(); c.moveTo(-size,0); c.lineTo(size*0.25,0); c.stroke();
  c.beginPath(); c.moveTo(size*1.05,0); c.lineTo(size*0.1,-size*0.72);
  c.lineTo(size*0.1,size*0.72); c.closePath(); c.fill();
  c.restore();
}
const ARROWS={up:1,down:1,left:1,right:1};
function word(t){
  if(ARROWS[t]) return t.toUpperCase();
  if(t==="pick") return "PICK UP";
  if(t==="open") return "OPEN";
  if(t==="end") return "END";
  if(t==="else") return "OR ELSE";
  if(t.startsWith("repeat:")) return "DO "+t.split(":")[1]+" TIMES";
  if(t.startsWith("if:")) return "IF "+sensor(t.slice(3));
  if(t.startsWith("set:")||t.startsWith("add:")){
    const p=t.split(":"); const n=parseInt(p[2],10);
    if(p[0]==="set") return `SET ${p[1]} = ${p[2]}`;
    return n<0?`TAKE ${-n} FROM ${p[1]}`:`ADD ${n} TO ${p[1]}`;
  }
  return t.toUpperCase();
}
/* A check has to read as something a child can go and look at. "IF NO WALL UP"
   is neither English nor a description of the board; "IF WAY UP IS CLEAR" is
   the same test written as the thing they should check. */
const SIDE={up:"ABOVE",down:"BELOW",left:"ON THE LEFT",right:"ON THE RIGHT"};
const WAY={up:"UP",down:"DOWN",left:"LEFT",right:"RIGHT"};
function sensor(cd){
  if(cd.startsWith("not-")){
    const b=cd.slice(4);
    if(b.startsWith("wall-")) return "WAY "+WAY[b.split("-")[1]]+" IS CLEAR";
    if(b==="star") return "NOT ON A STAR";
    return "NOT "+sensor(b);
  }
  if(cd==="star") return "ON A STAR";
  if(cd==="key") return "HOLDING THE KEY";
  if(cd==="door") return "AT THE DOOR";
  if(cd.startsWith("wall-")) return "WALL "+SIDE[cd.split("-")[1]];
  return cd.toUpperCase();
}
const isScaffold = t => t.startsWith("repeat:")||t==="end"||t==="else"||t.startsWith("if:");

/* ------------------------------------------------------------- pictures */
function drawBoard(c,b,x,y,w,h){
  const pad=6, cw=b.w||5, ch=b.h||5;
  const cell=Math.min((w-pad*2)/cw,(h-pad*2)/ch);
  const ox=x+(w-cell*cw)/2, oy=y+(h-cell*ch)/2;
  const T=(gx,gy)=>[ox+gx*cell, oy+(ch-1-gy)*cell];
  const walls=new Set((b.walls||[]).map(p=>p.join(",")));
  for(let gy=0;gy<ch;gy++)for(let gx=0;gx<cw;gx++){
    if(walls.has(gx+","+gy))continue;
    const [tx,ty]=T(gx,gy);
    rrect(c,tx+2,ty+2,cell-4,cell-4,8,(gx+gy)%2===0?K.tile:K.tileAlt);
  }
  for(const p of (b.walls||[])){const [tx,ty]=T(p[0],p[1]);
    rrect(c,tx+2,ty+2,cell-4,cell-4,8,K.wall);}
  for(const s of (b.stars||[])){const [tx,ty]=T(s[0],s[1]);
    glyph(c,"star",tx+cell/2,ty+cell/2,cell*0.26,K.accent,K.accentLedge);}
  if(b.goal){const [tx,ty]=T(b.goal[0],b.goal[1]);
    c.strokeStyle="#5B6070";c.lineWidth=2;
    c.beginPath();c.moveTo(tx+cell*0.36,ty+cell*0.24);c.lineTo(tx+cell*0.36,ty+cell*0.78);c.stroke();
    c.fillStyle="#2FBF71";c.beginPath();c.moveTo(tx+cell*0.36,ty+cell*0.24);
    c.lineTo(tx+cell*0.74,ty+cell*0.38);c.lineTo(tx+cell*0.36,ty+cell*0.5);c.closePath();c.fill();}
  if(b.key){const [tx,ty]=T(b.key[0],b.key[1]);
    c.fillStyle=K.accent;c.beginPath();c.arc(tx+cell*0.4,ty+cell*0.5,cell*0.13,0,7);c.fill();
    c.fillRect(tx+cell*0.44,ty+cell*0.45,cell*0.3,cell*0.09);}
  if(b.door){const [tx,ty]=T(b.door[0],b.door[1]);
    rrect(c,tx+cell*0.24,ty+cell*0.2,cell*0.52,cell*0.62,5,"#B98A5A");}
  const st=b.start||[0,0];
  const [bx,by]=T(st[0],st[1]);
  if(nupo.complete&&nupo.naturalWidth)
    c.drawImage(nupo,bx+cell*0.12,by+cell*0.1,cell*0.76,cell*0.76);
  else{c.fillStyle=K.primary;c.beginPath();c.arc(bx+cell/2,by+cell/2,cell*0.3,0,7);c.fill();}
  return cell;
}
function drawListing(c,prog,x,y,w,compact){
  const rowH=compact?34:44, gap=compact?6:8, gut=17, indent=9;
  let depth=0;
  prog.forEach((t,i)=>{
    let d=depth;
    if(t==="end"){depth=Math.max(0,depth-1); d=depth;}
    else if(t==="else"){d=Math.max(0,depth-1);}
    else if(t.startsWith("repeat:")||t.startsWith("if:")){d=depth; depth++;}
    const ry=y+i*(rowH+gap), bx=x+gut+d*indent, bw=w-gut-d*indent;
    const scaf=isScaffold(t);
    text(c,String(i+1),x+7,ry+rowH/2,12,K.muted,600);
    rrect(c,bx,ry,bw,rowH,rowH/2.6,scaf?"#F3EFFF":K.surface,scaf?"#E4DBFF":K.line,1.5);
    const label=word(t);
    if(scaf) text(c,label,bx+bw/2,ry+rowH/2,label.length>11?11.5:13.5,K.primary,800,"center");
    else{
      if(ARROWS[t]) arrow(c,bx+18,ry+rowH/2,8,t,K.text);
      text(c,label,bx+31,ry+rowH/2,label.length>12?11.5:13.5,K.text,800);
    }
  });
  return prog.length*(rowH+gap);
}
function drawTenFrame(c,pic,x,y,w){
  const frames=(pic.second>=0)?2:1;
  const cell=Math.min((w-8)/5,56);
  const ox=x+(w-cell*5)/2;
  for(let f=0;f<frames;f++){
    const oy=y+f*(cell*2+14);
    const n=f?pic.second:Math.min(pic.filled,10);
    const face=f?K.accent:K.primary, led=f?K.accentLedge:K.primaryLedge;
    for(let i=0;i<10;i++){
      const cx=ox+(i%5)*cell, cy=oy+Math.floor(i/5)*cell;
      rrect(c,cx+3,cy+3,cell-6,cell-6,9,K.surface,K.line,2);
      if(i<n) glyph(c,pic.glyph||"circle",cx+cell/2,cy+cell/2,cell*0.27,face,led);
    }
  }
  return frames*(cell*2)+(frames-1)*14;
}
function drawCount(c,pic,x,y,w){
  const per=5, cell=Math.min(w/per,62), rows=Math.ceil(pic.n/per);
  const total=Math.min(pic.n,per)*cell, ox=x+(w-total)/2;
  for(let i=0;i<pic.n;i++){
    const second=pic.splitAt>=0&&i>=pic.splitAt;
    glyph(c,pic.glyph||"star",ox+(i%per)*cell+cell/2,y+Math.floor(i/per)*cell+cell/2,
      cell*0.33,second?K.accent:K.primary,second?K.accentLedge:K.primaryLedge);
  }
  return Math.max(rows*cell,48);
}
function drawLine(c,pic,x,y,w){
  const h=104, pad=24, yy=y+h*0.42, span=w-pad*2;
  const from=pic.from||0, to=pic.to==null?10:pic.to, steps=Math.max(1,to-from);
  const X=n=>x+pad+span*(n-from)/steps;
  c.strokeStyle=K.line; c.lineWidth=3;
  c.beginPath(); c.moveTo(X(from),yy); c.lineTo(X(to),yy); c.stroke();
  for(let n=from;n<=to;n++){
    const lab=n===from||n===to||((n-from)%(pic.labelEvery||1)===0);
    c.strokeStyle=K.ledge; c.lineWidth=2;
    c.beginPath(); c.moveTo(X(n),yy-(lab?9:5)); c.lineTo(X(n),yy+(lab?9:5)); c.stroke();
    if(lab) text(c,String(n),X(n),yy+32,13,K.muted,800,"center");
  }
  if(pic.marker!=null) glyph(c,"circle",X(pic.marker),yy,10,K.accent,K.accentLedge);
  if(pic.step>1) text(c,`hops of ${pic.step}`,x+w-pad,yy-26,11.5,K.muted,700,"right");
  return h;
}
function drawBond(c,pic,x,y,w){
  const h=196, r=Math.min(38,w/6.5), cx=x+w/2;
  const topY=y+r+4, botY=y+h-r-4, dx=Math.min(w/4,88);
  c.strokeStyle=K.line; c.lineWidth=3;
  c.beginPath(); c.moveTo(cx,topY+r*0.9); c.lineTo(cx-dx,botY-r*0.9); c.stroke();
  c.beginPath(); c.moveTo(cx,topY+r*0.9); c.lineTo(cx+dx,botY-r*0.9); c.stroke();
  const node=(nx,ny,v,gap)=>{
    c.beginPath(); c.arc(nx,ny,r,0,7);
    c.fillStyle=gap?"#F1EBFF":K.surface; c.fill();
    c.lineWidth=gap?3:2; c.strokeStyle=gap?K.primary:K.line; c.stroke();
    text(c,v==null?"?":String(v),nx,ny,r*0.9,gap?K.primary:K.text,900,"center");
  };
  node(cx,topY,pic.whole,pic.gap==="whole");
  node(cx-dx,botY,pic.left,pic.gap==="left");
  node(cx+dx,botY,pic.right,pic.gap==="right");
  return h;
}
function drawBalance(c,pic,x,y,w){
  const h=196, cx=x+w/2, pivotY=y+h*0.36, arm=Math.min(w*0.78,300)/2;
  // The heavier pan goes DOWN. Larger y is lower on a canvas, so a heavier
  // left means a LARGER ly — the old code negated this and lifted the heavy
  // side, teaching the opposite of how a balance works.
  const diff=Math.max(-3,Math.min(3,pic.leftCount-pic.rightCount))/3;
  const tilt=diff*30;
  c.fillStyle=K.ledge;
  rrect(c,cx-7,pivotY-4,14,y+h-14-(pivotY-4),5,K.ledge);
  rrect(c,cx-46,y+h-18,92,14,7,K.ledge);
  const ly=pivotY+tilt, ry=pivotY-tilt;
  c.strokeStyle=K.primary; c.lineWidth=8; c.lineCap="round";
  c.beginPath(); c.moveTo(cx-arm,ly); c.lineTo(cx+arm,ry); c.stroke();
  c.fillStyle=K.primaryLedge; c.beginPath(); c.arc(cx,pivotY,11,0,7); c.fill();
  const pan=(px,py,n,face,led)=>{
    const panTop=py+42;
    c.strokeStyle=K.ledge; c.lineWidth=2.5;
    c.beginPath(); c.moveTo(px,py); c.lineTo(px,panTop); c.stroke();
    rrect(c,px-40,panTop,80,9,5,K.line);
    const r=8, per=4;
    for(let i=0;i<Math.min(n,9);i++){
      const col=i%per, row=Math.floor(i/per);
      const cols=Math.min(n-row*per,per);
      glyph(c,pic.glyph||"star",px+(col-(cols-1)/2)*r*2.15,
        panTop-r*1.05-row*r*2.05,r,face,led);
    }
  };
  pan(cx-arm,ly,pic.leftCount,K.primary,K.primaryLedge);
  pan(cx+arm,ry,pic.rightCount,K.accent,K.accentLedge);
  return h;
}
function drawRods(c,pic,x,y,w){
  const h=200, tens=Math.floor(pic.n/10), ones=pic.n%10;
  const unit=Math.min(18,h/11.5,w/14), rodH=unit*10, gap=unit*0.7;
  const cols=tens+(ones?1:0); if(!cols) return h;
  const total=cols*unit+(cols-1)*gap, ox=x+(w-total)/2, oy=y+(h-rodH)/2;
  const cube=(bx,by,face,led)=>{
    const s=unit*0.9;
    rrect(c,bx+unit/2-s/2,by+unit/2-s/2+unit*0.08,s,s,unit*0.22,led);
    rrect(c,bx+unit/2-s/2,by+unit/2-s/2,s,s,unit*0.22,face);
  };
  for(let t=0;t<tens;t++)for(let k=0;k<10;k++)
    cube(ox+t*(unit+gap),oy+k*unit,K.primary,K.primaryLedge);
  for(let k=0;k<ones;k++)
    cube(ox+tens*(unit+gap),oy+rodH-(k+1)*unit,K.accent,K.accentLedge);
  return h;
}
const SPOTS={1:[[1,1]],2:[[0,0],[2,2]],3:[[0,0],[1,1],[2,2]],
  4:[[0,0],[2,0],[0,2],[2,2]],5:[[0,0],[2,0],[1,1],[0,2],[2,2]],
  6:[[0,0],[2,0],[0,1],[2,1],[0,2],[2,2]]};
function drawDice(c,pic,x,y,w){
  const faces=pic.faces&&pic.faces.length?pic.faces:[pic.n||1];
  const face=Math.min((w-16*(faces.length-1))/faces.length,112);
  const total=face*faces.length+16*(faces.length-1), ox=x+(w-total)/2;
  faces.forEach((n,fi)=>{
    const left=ox+fi*(face+16);
    rrect(c,left,y+4,face,face,face*0.2,K.ledge);
    rrect(c,left,y,face,face,face*0.2,K.surface,K.line,2);
    const dot=face*0.11, step=face*0.27, c0=left+face/2, r0=y+face/2;
    const col=fi?K.accent:K.primary, led=fi?K.accentLedge:K.primaryLedge;
    (SPOTS[Math.max(1,Math.min(6,n))]||[]).forEach(([gx,gy])=>
      glyph(c,"circle",c0+(gx-1)*step,r0+(gy-1)*step,dot,col,led));
  });
  return face+12;
}
function drawMirror(c,pic,x,y,w){
  const cols=pic.cols||6, rows=pic.rows||5;
  const cell=Math.min(w/cols,46), ox=x+(w-cell*cols)/2;
  const given=new Set((pic.given||[]).map(g=>g.join(",")));
  for(let r=0;r<rows;r++)for(let cc=0;cc<cols;cc++){
    const gx=ox+cc*cell, gy=y+r*cell, on=given.has(cc+","+r);
    rrect(c,gx+2.5,gy+2.5,cell-5,cell-5,7,on?K.surface:"#F7F6FC",K.line,1.5);
    if(on) glyph(c,"square",gx+cell/2,gy+cell/2,cell*0.3,K.primary,K.primaryLedge);
  }
  const mx=ox+cell*cols/2;
  c.save(); c.setLineDash([9,7]); c.strokeStyle=K.primary; c.lineWidth=3;
  c.beginPath(); c.moveTo(mx,y); c.lineTo(mx,y+cell*rows); c.stroke(); c.restore();
  return cell*rows;
}
function drawFigure(c,pic,x,y,w){
  // The polygons travel with the question, so this page and the app cannot
