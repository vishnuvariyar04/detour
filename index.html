  rrect(c,W-78,44,62,34,17,K.surface,K.line,1.5);
  text(c,"Parent",W-47,61,13,K.muted,800,"center");

  const M=16, CW=W-M*2;
  let y=100;
  y=wrap(c,q.prompt,M,y,CW,18,K.text,900,26)+10;

  const pic=q.pic, vis=q.visual, sh=q.shape;
  const P={c,x:M,w:CW};
  const put=fn=>{y+=fn+16;};

  if(pic){
    switch(sh){
      case "countObjects": put(drawCount(c,pic,M,y,CW)); break;
      case "tenFrame":     put(drawTenFrame(c,pic,M,y,CW)); break;
      case "numberLine":   put(drawLine(c,pic,M,y,CW)); break;
      case "bond":         put(drawBond(c,pic,M,y,CW)); break;
      case "balance":      put(drawBalance(c,pic,M,y,CW)); break;
      case "rods":         put(drawRods(c,pic,M,y,CW)); break;
      case "dice":         put(drawDice(c,pic,M,y,CW)); break;
      case "mirror":       put(drawMirror(c,pic,M,y,CW)); break;
      case "shapeHunt":
      case "shapeCount":   put(drawFigure(c,pic,M,y,CW)); break;
      case "array":        put(drawArray(c,pic,M,y,CW)); break;
      case "groups":       put(drawGroups(c,pic,M,y,CW)); break;
      case "barModel":     put(drawBars(c,pic,M,y,CW)); break;
      case "fractionWall": put(drawWall(c,pic,M,y,CW)); break;
      case "pattern":      put(drawPattern(c,pic,M,y,CW)); break;
      case "oddOneOut":    put(drawOdd(c,pic,M,y,CW)); break;
      case "sortTwo":      put(drawSort(c,pic,M,y,CW)); break;
      case "analogy":      put(drawAnalogy(c,pic,M,y,CW)); break;
      case "codeRead":
      case "codePick":     put(drawCode(c,pic,M,y,CW)); break;
      case "sequence": case "nthTerm": case "termPosition": case "seqRule":
                           put(drawSequence(c,pic,M,y,CW)); break;
      case "ifThen": case "claim":
                           put(drawClues(c,pic,M,y,CW)); break;
      case "deduce":       put(drawDeduce(c,pic,M,y,CW)); break;
      case "binaryRead": case "binaryPick":
                           put(drawBulbs(c,pic,M,y,CW)); break;
      case "cipher": case "cipherWrite":
                           put(drawShift(c,pic,M,y,CW)); break;
      case "symbolCode":   put(drawSymbols(c,pic,M,y,CW)); break;
      case "letterCode": case "letterSum":
                           put(drawLetters(c,pic,M,y,CW)); break;
      case "netFace":      put(drawNet(c,pic,M,y,CW)); break;
      case "roll":         put(drawRoll(c,pic,M,y,CW)); break;
      case "stackCount": case "stackFill": case "stackView":
                           put(drawStack(c,pic,M,y,CW)); break;
      case "knights":      put(drawClues(c,pic,M,y,CW)); break;
      case "story": case "riddle": case "rank": case "rankCount": case "queueCalc":
      case "relation": case "relationWho": case "weekday": case "month": case "combos":
                           put(drawClues(c,pic,M,y,CW)); break;
      case "equation":     put(drawEquation(c,pic,M,y,CW)); break;
      case "bars":         put(drawBarPair(c,pic,M,y,CW)); break;
      case "series": case "seriesRule":
                           put(drawSequence(c,pic,M,y,CW)); break;
      case "queueBack": case "queueWho":
                           put(drawQueue(c,pic,M,y,CW)); break;
      case "turns":        put(drawCompass(c,pic,M,y,CW)); break;
      case "shelf":        put(drawShelf(c,pic,M,y,CW)); break;
      case "wordAnalogy":  put(drawWordPairs(c,pic,M,y,CW)); break;
      case "numberAnalogy": put(drawNumPairs(c,pic,M,y,CW)); break;
